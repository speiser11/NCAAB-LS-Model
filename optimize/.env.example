# Copy this file to .env (same folder) and fill in your real key.
# .env is gitignored — it will never be committed.
#
# Load it before running optimize.py:
#   macOS/Linux:  export $(cat optimize/.env | xargs)
#   or use `python-dotenv` if you prefer: pip install python-dotenv

ODDS_API_KEY=your_key_here
